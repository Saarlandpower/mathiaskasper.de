---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { fmtDate } from '../../lib';

export async function getStaticPaths() {
  const snippets = await getCollection('snippets');
  return snippets.map((s) => ({ params: { slug: s.id }, props: { s } }));
}
const { s } = Astro.props;
const { Content } = await render(s);
---
<Base title={s.data.title} description={s.data.summary}>
  <a class="back" href="/snippets/">← Alle Snippets</a>
  <div class="eyebrow">{s.data.lang} · {fmtDate(s.data.date)}</div>
  <h1>{s.data.title}</h1>
  <p class="lead">{s.data.summary}</p>
  <div class="links">{s.data.tags.map((t) => <span class="tag">{t}</span>)}</div>
  <article class="prose"><Content /></article>
</Base>
